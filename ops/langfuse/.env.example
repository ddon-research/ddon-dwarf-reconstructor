# Local Langfuse configuration for Docker Desktop.
# Copy to .env, replace the REPLACE_WITH values, then run:
#   docker compose --file ops/langfuse/compose.yaml --env-file ops/langfuse/.env up -d
# Never commit ops/langfuse/.env.

# Keep these image references coordinated with the Langfuse release.
LANGFUSE_IMAGE=docker.io/langfuse/langfuse:4
LANGFUSE_WORKER_IMAGE=docker.io/langfuse/langfuse-worker:4
CLICKHOUSE_VERSION=25.12
POSTGRES_VERSION=17
REDIS_VERSION=7
MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:82253cf7ef17ca975187a938245bec6be17576a037556b0adb72d8e13c426360

# Host ports are intentionally loopback-only in compose.yaml.
LANGFUSE_PORT=3000
MINIO_PORT=9090
NEXTAUTH_URL=http://localhost:3000
LANGFUSE_S3_MEDIA_UPLOAD_EXTERNAL_ENDPOINT=http://localhost:9090

# Internal service credentials. Use long random values with letters and digits.
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=REPLACE_WITH_RANDOM_CLICKHOUSE_PASSWORD
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_MINIO_PASSWORD
REDIS_AUTH=REPLACE_WITH_RANDOM_REDIS_PASSWORD
SALT=REPLACE_WITH_RANDOM_SALT
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_ENCRYPTION_KEY
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_NEXTAUTH_SECRET

# Disable telemetry from the self-hosted Langfuse instance by default.
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false
